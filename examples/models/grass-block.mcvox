# A grass block: dirt with grass over its top and a ragged fringe down its sides.
# Every face tiles seamlessly.
schema = 1
name   = "base:grass_block"
scale  = 16
size   = [16, 16, 16]
origin = [8, 0, 8]
slice  = "y"

[palette]
"g" = "base:grass"
"G" = "base:grass_dark"
"b" = "base:grass_deep"
"l" = "base:grass_light"
"y" = "base:grass_pale"
"d" = "base:dirt"
"D" = "base:dirt_dark"
"m" = "base:dirt_light"

[[layers]]                # y = 0, the underside: earth, seen whole from below
y = 0
grid = """
DdddddmddddddddD
ddDmdmdDDDmdddmd
dddddddDdddddmdd
ddDDdmddddDdmddd
ddDmddddDddddddd
